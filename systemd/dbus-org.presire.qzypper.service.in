[Unit]
Description=qZypper D-Bus backend (libzypp package manager)

[Service]
Type=dbus
BusName=org.presire.qzypper
User=root
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/qzypper-backend
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UnsetEnvironment=LD_LIBRARY_PATH LD_PRELOAD LD_AUDIT GLIBC_TUNABLES
UnsetEnvironment=XDG_CONFIG_HOME XDG_CONFIG_DIRS XDG_CACHE_HOME XDG_DATA_HOME XDG_DATA_DIRS XDG_STATE_HOME XDG_RUNTIME_DIR
UnsetEnvironment=GNUPGHOME GPG_AGENT_INFO DBUS_SESSION_BUS_ADDRESS
UnsetEnvironment=QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH QML_IMPORT_PATH QML2_IMPORT_PATH
UnsetEnvironment=ZYPP_CONF ZYPP_REPO_RELEASEVER ZYPP_PLUGIN_SEND_TIMEOUT ZYPP_PLUGIN_RECEIVE_TIMEOUT ZYPP_PLUGIN_TIMEOUT
UnsetEnvironment=ZYPP_PLUGIN_DEBUG ZYPP_PLUGIN_APPDATA_FORCE_COLLECT ZYPP_LOCK_TIMEOUT ZYPP_LOCKFILE_ROOT ZYPP_READONLY_HACK ZYPPTMPDIR
UnsetEnvironment=ZYPP_LOGFILE ZYPP_FULLLOG ZYPP_LIBSOLV_FULLLOG ZYPP_LIBSAT_FULLLOG LIBSOLV_DEBUGMASK ZYPP_MEDIA_CURL_DEBUG ZYPP_METALINK_DEBUG ZYPP_RPM_DEBUG ZYPP_PROFILING
UnsetEnvironment=ZYPP_MEDIA_CURL ZYPP_MEDIA_CURL_IPRESOLVE ZYPP_CURL2 ZYPP_PCK_PRELOAD ZYPP_SINGLE_RPMTRANS ZYPP_CLASSIC_RPMTRANS ZYPP_COMMIT_NO_PACKAGE_CACHE
UnsetEnvironment=ZYPP_MODALIAS_SYSFS ZYPP_TESTSUITE_FAKE_ARCH ZYPP_FORK_BACKEND ZYPP_NO_USRMERGE_PROTECT ZYPP_REPOMD_WITH_FILELISTS ZYPP_REPOMD_WITH_OTHER
UnsetEnvironment=RPM_CONFIGDIR RPM_POPTEXEC_PATH
