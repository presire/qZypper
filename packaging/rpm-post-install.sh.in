#!/bin/bash
# qZypper RPM %post script
# Load SELinux policy module and relabel binaries

if command -v semodule >/dev/null 2>&1 && selinuxenabled 2>/dev/null; then
    if semodule -i /usr/share/selinux/packages/qzypper.pp; then
        :
    else
        echo "qZypper: warning: 'semodule -i /usr/share/selinux/packages/qzypper.pp' failed with exit status $?" >&2
    fi
    if command -v restorecon >/dev/null 2>&1; then
        if restorecon -R @CMAKE_INSTALL_FULL_BINDIR@/qzypper; then
            :
        else
            echo "qZypper: warning: 'restorecon -R @CMAKE_INSTALL_FULL_BINDIR@/qzypper' failed with exit status $?" >&2
        fi
        if restorecon -R @CMAKE_INSTALL_FULL_LIBEXECDIR@/qzypper-backend; then
            :
        else
            echo "qZypper: warning: 'restorecon -R @CMAKE_INSTALL_FULL_LIBEXECDIR@/qzypper-backend' failed with exit status $?" >&2
        fi
    fi
fi

# Never fail the RPM transaction because of SELinux setup problems.
exit 0
